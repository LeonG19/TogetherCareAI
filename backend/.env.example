# Copy this to .env (backend/.env) before running:
#   python -m uvicorn backend:app --host 127.0.0.1 --port 8000
#
# backend.py loads backend/.env at import via python-dotenv with
# override=False, so a real environment variable always beats this file.

# ---------------------------------------------------------------------------
# LLM endpoint. Any OpenAI-compatible /v1/chat/completions server.
# ---------------------------------------------------------------------------
# Hosted HF Inference Endpoint:
#   HF_ENDPOINT=https://<id>.<region>.aws.endpoints.huggingface.cloud
#   HF_MODEL=ERivas8/empathy-llama3-8b
#   HF_TOKEN=hf_...
# Local vLLM (see scripts/run_vllm.sh):
#   HF_ENDPOINT=http://127.0.0.1:8001
#   HF_MODEL=togethercare-llama3-8b
#   HF_TOKEN=<the VLLM_KEY the server was started with>
HF_ENDPOINT=http://127.0.0.1:8001
HF_MODEL=togethercare-llama3-8b
HF_TOKEN=

# Seconds to wait on a single request to the endpoint.
HF_TIMEOUT=300

# Retry budget for transient upstream failures: HTTP 503 (a hosted endpoint
# waking from scale-to-zero) and connection-refused (a local vLLM server that
# is still loading weights, which takes minutes for an 8B model). Defaults are
# 12 attempts x 10s ~= 2 minutes.
HF_MAX_RETRIES=12
HF_RETRY_WAIT=10

# ---------------------------------------------------------------------------
# Retrieval. Off by default.
# ---------------------------------------------------------------------------
# RAG_ENABLED=1 is what causes backend.py to import torch,
# sentence-transformers, numpy, faiss and pinecone -- and therefore what makes
# requirements-rag.txt necessary. With RAG_ENABLED=0 none of that is imported
# and no vector store is needed at all.
RAG_ENABLED=0

# Which vector store: "faiss" (local, no key, exact search) or "pinecone".
RAG_BACKEND=faiss

# For RAG_BACKEND=faiss: a directory holding index.faiss + meta.jsonl +
# embed_model.txt. The embed_model.txt stamp is checked against
# EMBED_MODEL_NAME at load, because querying an index with a different encoder
# returns plausible-looking garbage instead of failing.
FAISS_INDEX_DIR=/mnt/lagarza3/llm-healthcare/indexes/faiss_default

# Cosine floor for a chunk to be cited. The index is inner-product over
# L2-normalised vectors, so scores are cosine in [-1, 1].
RAG_MIN_SCORE=0.7

# For RAG_BACKEND=pinecone. The index "empathy-rag" is dimension 384 /
# metric=cosine, which matches EMBED_MODEL_NAME (all-MiniLM-L6-v2) in
# backend.py; _init_rag() calls describe_index_stats() at startup and refuses
# to start on a dimension mismatch, a bad key, or a missing index name --
# retrieve_top_k() is wrapped in try/except at every call site, so a store
# that fails lazily would leave a chatbot that silently never cites anything.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=empathy-rag

# Leave empty for the index's default namespace, which is where the
# empathy-rag vectors are. Only set this if the index is later partitioned.
PINECONE_NAMESPACE=

# ---------------------------------------------------------------------------
# NOT the same variable as HF_ENDPOINT above -- read this before changing it.
# ---------------------------------------------------------------------------
# huggingface_hub reads the environment variable HF_ENDPOINT as the Hub base
# URL. This app has used that same name since before RAG existed, to mean the
# LLM inference endpoint. When RAG is on and HF_ENDPOINT points at a local
# vLLM server, sentence-transformers would try to download the encoder from
# the vLLM server and 404. _init_rag() shadows HF_ENDPOINT with this value for
# the duration of the encoder load, then restores it. Set to "" to force
# cache-only / offline.
HF_HUB_ENDPOINT=https://huggingface.co

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
# Optional: require this header (x-api-key) on every request
API_KEY=

# Comma-separated list of origins allowed to call this backend from a browser.
# Set to "*" for local testing. Once the frontend is deployed via Cloudflare
# Containers, set this to its real URL(s), e.g.:
#   ALLOWED_ORIGINS=https://togethercareai-frontend.<subdomain>.workers.dev
ALLOWED_ORIGINS=*

LOG_DIR=logs
LOG_ENABLED=1
COMMENTS_DIR=comments
COMMENTS_ENABLED=1

# Known quirk, see README: A/B mode is ON when this is unset OR set to "0",
# and OFF for any other value. Leaving it as-is for behavioural parity.
# AB_ENABLED=0
AB_EVERY_N=5

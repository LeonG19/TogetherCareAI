# Copy to web/.env and fill in the three blanks below. server.js refuses to
# start unless ACCESS_CODE and SESSION_SECRET are both set.
#
# Generate the two secrets with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"   # SESSION_SECRET
#   ACCESS_CODE can be anything you are willing to read out loud.
PORT=8080

# Where the FastAPI backend listens. Loopback only; the web tier is the only
# thing that talks to it.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010

# The backend's own API_KEY, attached to proxied requests server-side. The
# browser never receives this. Must match API_KEY in backend/.env.
BACKEND_API_KEY=

# The passcode handed out to testers. Change it to whatever you want to say
# out loud; restart the service afterwards.
ACCESS_CODE=

# Signs the access cookie. Rotating this immediately logs everyone out,
# which is how you revoke access without changing the passcode.
SESSION_SECRET=

# How long one successful code entry lasts before it is asked for again.
SESSION_HOURS=12

# Brute-force budget per client IP.
MAX_ATTEMPTS=10
LOCKOUT_MINUTES=15

# "auto" = mark the cookie Secure only when the request arrived over https
# (which cloudflared reports). Leave on auto so local http testing works too.
COOKIE_SECURE=auto
